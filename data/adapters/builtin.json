[
  {
    "provider": "openai",
    "models": ["*"],
    "api_style": "openai-chat",
    "base_url": "https://api.openai.com",
    "endpoint": "/v1/chat/completions",
    "auth": "bearer",
    "param_mapping": {
      "max_tokens": "max_completion_tokens"
    },
    "unsupported_params": ["top_k", "min_p", "repetition_penalty"],
    "defaults": {
      "temperature": 0.7
    },
    "multimodal_format": "openai_image_url"
  },
  {
    "provider": "anthropic",
    "models": ["*"],
    "api_style": "anthropic-messages",
    "base_url": "https://api.anthropic.com",
    "endpoint": "/v1/messages",
    "auth": "x-api-key",
    "headers": {
      "anthropic-version": "2023-06-01"
    },
    "param_mapping": {
      "max_completion_tokens": "max_tokens"
    },
    "unsupported_params": ["frequency_penalty", "presence_penalty", "logit_bias"],
    "defaults": {
      "max_tokens": 4096,
      "temperature": 1
    },
    "multimodal_format": "anthropic_base64"
  },
  {
    "provider": "google",
    "models": ["*"],
    "api_style": "gemini-generate",
    "base_url": "https://generativelanguage.googleapis.com",
    "endpoint": "/v1beta/models/{model}:generateContent",
    "auth": "query",
    "param_mapping": {
      "max_tokens": "maxOutputTokens",
      "top_p": "topP",
      "top_k": "topK",
      "temperature": "temperature"
    },
    "unsupported_params": ["frequency_penalty", "presence_penalty"],
    "defaults": {
      "temperature": 1
    },
    "multimodal_format": "gemini_inline_data"
  },
  {
    "provider": "deepseek",
    "models": ["*"],
    "api_style": "openai-chat",
