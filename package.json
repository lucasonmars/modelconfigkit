{
  "name": "modelconfigkit",
  "version": "0.1.0",
  "description": "Download once. Configure any model. Embeddable model config knowledge base — provider + model + API key; endpoints, params, multimodal formats included.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": "./data/registry.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "modelconfigkit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "import:registry": "node scripts/import-registry.mjs",
    "stats": "node scripts/stats.mjs",
    "test": "node --test dist/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "provider",
    "model-config",
    "model-registry",
    "adapter",
    "openai-compatible",
    "multimodal",
    "ai-sdk"
  ],
  "author": "lucasonmars",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasonmars/modelconfigkit.git"
  },
  "bugs": {
    "url": "https://github.com/lucasonmars/modelconfigkit/issues"
  },
  "homepage": "https://github.com/lucasonmars/modelconfigkit#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
